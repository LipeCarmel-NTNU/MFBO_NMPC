-promotedMask      = ~origParetoMatched & refParetoMatched;
-promotedZlt1Mask  = promotedMask & isfinite(zOrigMatched) & (zOrigMatched < 1 - 1e-12);
-promotedIdxOrig   = idxOrig(promotedZlt1Mask);
