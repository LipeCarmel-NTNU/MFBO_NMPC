+    m = cfg.timeout_penalty_margin
+    pen_sse = (1.0 + m) * max(sse) if sse else cfg.timeout_penalty_fallback
+    pen_ssdu = (1.0 + m) * max(ssdu) if ssdu else cfg.timeout_penalty_fallback
+    return pen_sse, pen_ssdu
